+static int vtdr6130_power_off(struct panel_info *pinfo, unsigned int count)
+{
+	int ret, error = 0;
+
+	if (!pinfo->desc->supply_config)
+		return regulator_bulk_disable(count, pinfo->supplies);
+
+	while (count--) {
+		ret = regulator_disable(pinfo->supplies[count].consumer);
+		if (ret) {
+			dev_err(&pinfo->dsi->dev, "Failed to disable %s: %d\n",
+				pinfo->supplies[count].supply, ret);
+			if (!error)
+				error = ret;
+		}
+	}
+
+	return error;
+}
+
+static int vtdr6130_power_on(struct panel_info *pinfo)
+{
+	const struct vtdr6130_supply_config *config = pinfo->desc->supply_config;
+	unsigned int i;
+	int ret;
+
+	if (!config)
+		return regulator_bulk_enable(pinfo->desc->num_supplies, pinfo->supplies);
+
+	for (i = 0; i < pinfo->desc->num_supplies; i++) {
+		struct regulator *regulator = pinfo->supplies[i].consumer;
+
+		ret = regulator_set_voltage(regulator, config[i].voltage_uv,
+					    config[i].voltage_uv);
+		if (ret)
+			goto error;
+		ret = regulator_set_load(regulator, config[i].load_ua);
+		if (ret)
+			goto error;
+		ret = regulator_enable(regulator);
+		if (ret)
+			goto error;
+		if (config[i].delay_ms)
+			msleep(config[i].delay_ms);
+	}
+
+	return 0;
+
+error:
+	dev_err(&pinfo->dsi->dev, "Failed to enable %s: %d\n",
+		pinfo->supplies[i].supply, ret);
+	vtdr6130_power_off(pinfo, i);
+	return ret;
+}
