+static void vtdr6130_o2p_write(struct mipi_dsi_multi_context *ctx,
+			       const u8 *data, size_t len)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	const struct mipi_dsi_host_ops *ops = dsi->host->ops;
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.type = MIPI_DSI_DCS_LONG_WRITE,
+		.flags = MIPI_DSI_MSG_USE_LPM,
+		.tx_len = len,
+		.tx_buf = data,
+	};
+	ssize_t ret;
+
+	if (ctx->accum_err)
+		return;
+
+	if (!ops || !ops->transfer) {
+		ctx->accum_err = -EOPNOTSUPP;
+		return;
+	}
+
+	ret = ops->transfer(dsi->host, &msg);
+	/* MSM reports the padded packet size, including its header. */
+	if (ret < (ssize_t)len) {
+		ctx->accum_err = ret < 0 ? ret : -EIO;
+		dev_err(&dsi->dev,
+			"Command %#x failed: %d (transfer %zd, payload %zu)\n",
+			data[0], ctx->accum_err, ret, len);
+	}
+}
+
+#define vtdr6130_o2p_write_seq(ctx, seq...) do { \
+	static const u8 data[] = { seq }; \
+	vtdr6130_o2p_write(ctx, data, ARRAY_SIZE(data)); \
+} while (0)
+
